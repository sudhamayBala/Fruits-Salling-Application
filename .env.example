DB=FRUITS
DB_USER=postgres
DB_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-at-least-32-random-secret-bytes
ALLOW_FIRST_ADMIN_BOOTSTRAP=false
PGADMIN_DEFAULT_EMAIL=admin@fruithouse.local
PGADMIN_DEFAULT_PASSWORD=change-this-pgadmin-password
CORS_ORIGINS=http://localhost:2000,http://127.0.0.1:2000
# For Render, set DATABASE_URL, JWT_SECRET, and CORS_ORIGINS on both API services.
# Use the same database URL and JWT secret; set CORS_ORIGINS to the frontend URL.
